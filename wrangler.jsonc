{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "comake",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["DEMO_SESSION_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_ROOM", "class_name": "WorkspaceRoom" }
    ]
  },
  "exports": {
    "WorkspaceRoom": { "type": "durable-object", "storage": "sqlite" },
    "ProjectRoom": { "type": "durable-object", "state": "deleted" },
    "ProjectRegistry": { "type": "durable-object", "state": "deleted" }
  }
}
