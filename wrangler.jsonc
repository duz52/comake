{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "comake",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["DEMO_SESSION_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
      { "name": "PROJECT_REGISTRY", "class_name": "ProjectRegistry" }
    ]
  },
  "exports": {
    "ProjectRoom": { "type": "durable-object", "storage": "sqlite" },
    "ProjectRegistry": { "type": "durable-object", "storage": "sqlite" }
  }
}
